{
  "compilerOptions": {
    /* Language and Environment */
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,

    /* Output */
    "outDir": "./dist",
    "rootDir": ".",
    "sourceMap": true,
    "removeComments": true,

    /* Strictness */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    /* Type Definitions */
    "types": ["node"],
    "typeRoots": ["./node_modules/@types"],

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/generated/*": ["generated/*"]
    },

    /* Emit */
    "noEmitOnError": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src/**/*.ts", "generated/**/*.ts", "tests/**/*", "**/*.test.ts", "**/*.spec.ts"],
  "exclude": ["node_modules", "dist", "coverage", ".husky"],
  "ts-node": {
    "esm": true,
    "transpileOnly": true
  }
}
